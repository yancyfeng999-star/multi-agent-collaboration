{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint Schema",
  "description": "上下文检查点",
  "type": "object",
  "required": ["schema_version", "doc_type", "checkpoint_id", "agent_id", "created_at", "previous_checkpoint", "source_archives", "source_archive_hashes", "source_runtime_profiles", "source_runtime_profile_hashes", "content_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "doc_type": {"type": "string", "const": "checkpoint"},
    "checkpoint_id": {"type": "string", "pattern": "^CP-\\d{4}$"},
    "agent_id": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "task_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "previous_checkpoint": {"type": ["string", "null"], "pattern": "^CP-\\d{4}$"},
    "source_archives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_archive_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "source_runtime_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^agents/A\\d{2}-[a-z0-9][a-z0-9-]*/runtime/profiles/RP-\\d{6}\\.json$"}
    },
    "source_runtime_profile_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "source_message_range": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
