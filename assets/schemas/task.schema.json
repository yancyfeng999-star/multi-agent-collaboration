{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Schema",
  "type": "object",
  "required": ["schema_version", "doc_type", "task_id", "title", "owner", "goal", "dependencies", "allowed_writes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "doc_type": {"type": "string", "const": "task"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "owner": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "goal": {"type": "string", "minLength": 1},
    "why_this_owner": {"type": "string"},
    "project_root": {"type": "string"},
    "current_behavior": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "required_context_files": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "allowed_writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_writes": {"type": "array", "items": {"type": "string"}},
    "acceptance_commands": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "known_risks": {"type": "array", "items": {"type": "string"}},
    "handoff_to": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
