{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Schema",
  "type": "object",
  "required": ["schema_version", "doc_type", "task_id", "title", "owner", "goal", "dependencies", "allowed_writes"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["assignment_mode"], "properties": {"assignment_mode": {"const": "claimable"}}},
      "then": {"required": ["eligible_agents", "published_by"], "properties": {"owner": {"const": "pool"}}}
    },
    {
      "if": {"required": ["assignment_mode"], "properties": {"assignment_mode": {"const": "fixed"}}},
      "then": {"properties": {"owner": {"not": {"const": "pool"}}}}
    }
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "doc_type": {"type": "string", "const": "task"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "owner": {"type": "string", "minLength": 1},
    "role_ref": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assignment_mode": {"type": "string", "enum": ["fixed", "claimable"]},
    "eligible_agents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "published_by": {"type": "string"},
    "parent_task_id": {"type": ["string", "null"]},
    "parent_task_sha256": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "why_this_owner": {"type": "string"},
    "project_root": {"type": "string"},
    "current_behavior": {"type": "string"},
    "expected_behavior": {"type": "string"},
    "required_context_files": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "allowed_writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "logical_resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "environment_resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workspace_policy": {"type": "string", "enum": ["isolated_writer", "shared_read_only", "shared_no_git_mutation"]},
    "workspace": {"type": ["string", "null"]},
    "release_lane": {"type": "string", "minLength": 1},
    "resource_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "resources"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required": {"type": "boolean"},
          "queue_key": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "forbidden_writes": {"type": "array", "items": {"type": "string"}},
    "acceptance_commands": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "known_risks": {"type": "array", "items": {"type": "string"}},
    "handoff_to": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
