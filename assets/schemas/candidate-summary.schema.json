{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project release candidate summary",
  "type": "object",
  "required": ["schema_version", "run_id", "release_candidates", "release_authority"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string"},
    "governance": {"type": "string"},
    "versioning_mode": {"type": "string"},
    "release_candidates": {"type": "array", "items": {"type": "object"}},
    "release_authority": {"type": "string", "const": "project_release_adapter"}
  }
}
