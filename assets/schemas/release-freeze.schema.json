{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic canonical branch release freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "freeze_id", "active", "canonical_branch", "canonical_commit", "scope_paths", "reason", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "freeze_id": {"type": "string", "minLength": 1},
    "active": {"type": "boolean"},
    "canonical_branch": {"type": "string", "minLength": 1},
    "canonical_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "scope_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
