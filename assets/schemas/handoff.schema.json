{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Handoff Schema",
  "type": "object",
  "required": ["schema_version", "doc_type", "task_id", "agent_id", "status", "summary", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1"]},
    "doc_type": {"type": "string", "const": "handoff"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "agent_id": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "status": {"type": "string", "enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "runtime_profile_id": {"$ref": "#/definitions/runtimeProfileId"},
    "runtime_profile_sha256": {"$ref": "#/definitions/hash"},
    "activity_record_path": {"$ref": "#/definitions/activityRecordPath"},
    "activity_record_sha256": {"$ref": "#/definitions/hash"},
    "actual_model_status": {"$ref": "#/definitions/actualStatus"},
    "actual_model": {"type": ["string", "null"], "minLength": 1},
    "actual_provider_status": {"$ref": "#/definitions/actualStatus"},
    "actual_provider": {"type": ["string", "null"], "minLength": 1},
    "usage_summary": {"$ref": "#/definitions/usageSummary"},
    "root_cause_or_decision": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "untouched_boundaries": {"type": "array", "items": {"type": "string"}},
    "commands_run": {"type": "array", "items": {"type": "string"}},
    "exact_results": {"type": "array", "items": {"type": "string"}},
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/definitions/hash"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/definitions/hash"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "contract_changes_requested": {"type": "array", "items": {"type": "string"}},
    "recommended_next_owner": {"type": "string", "pattern": "^A\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "rollback_note": {"type": "string"}
  },
  "oneOf": [
    {
      "properties": {"schema_version": {"const": "1.0"}},
      "required": ["schema_version"],
      "not": {
        "anyOf": [
          {"required": ["runtime_profile_id"]},
          {"required": ["runtime_profile_sha256"]},
          {"required": ["activity_record_path"]},
          {"required": ["activity_record_sha256"]},
          {"required": ["actual_model_status"]},
          {"required": ["actual_model"]},
          {"required": ["actual_provider_status"]},
          {"required": ["actual_provider"]},
          {"required": ["usage_summary"]}
        ]
      }
    },
    {
      "properties": {"schema_version": {"const": "1.1"}},
      "required": [
        "schema_version", "runtime_profile_id", "runtime_profile_sha256",
        "activity_record_path", "activity_record_sha256",
        "actual_model_status", "actual_model", "actual_provider_status", "actual_provider",
        "usage_summary"
      ]
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"actual_model_status": {"const": "known"}}, "required": ["actual_model_status"]},
      "then": {"properties": {"actual_model": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"actual_model": {"type": "null"}}}
    },
    {
      "if": {"properties": {"actual_provider_status": {"const": "known"}}, "required": ["actual_provider_status"]},
      "then": {"properties": {"actual_provider": {"type": "string", "minLength": 1}}},
      "else": {"properties": {"actual_provider": {"type": "null"}}}
    }
  ],
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableHash": {"anyOf": [{"$ref": "#/definitions/hash"}, {"type": "null"}]},
    "runtimeProfileId": {"type": "string", "pattern": "^RP-[0-9]{6}$"},
    "actualStatus": {"type": "string", "enum": ["known", "unknown", "not_collected", "conflict"]},
    "activityRecordPath": {
      "type": "string",
      "pattern": "^agents/A[0-9]{2}-[a-z0-9][a-z0-9-]*/activity/RUN-[A-Za-z0-9][A-Za-z0-9._-]*/TASK-[A-Za-z0-9][A-Za-z0-9._-]*/ATTEMPT-[A-Za-z0-9][A-Za-z0-9._-]*/[0-9]{4}/[0-9]{2}/[0-9]{2}/ACTIVITY-[0-9]{6}\\.json$"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?#])(?!.*://).+$"
    },
    "nullableNonNegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "usageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_source", "input_tokens", "output_tokens", "cached_input_tokens",
        "reasoning_tokens", "total_tokens", "cost_minor_units", "currency",
        "source_ref", "source_sha256"
      ],
      "properties": {
        "usage_source": {"type": "string", "enum": ["provider_response", "runtime_meter", "billing_export", "none_required", "unavailable"]},
        "input_tokens": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "output_tokens": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "cached_input_tokens": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "reasoning_tokens": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "total_tokens": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "cost_minor_units": {"$ref": "#/definitions/nullableNonNegativeInteger"},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "source_ref": {"anyOf": [{"$ref": "#/definitions/safeRef"}, {"type": "null"}]},
        "source_sha256": {"$ref": "#/definitions/nullableHash"}
      },
      "allOf": [
        {
          "if": {"properties": {"usage_source": {"enum": ["provider_response", "runtime_meter", "billing_export"]}}, "required": ["usage_source"]},
          "then": {
            "properties": {
              "source_ref": {"$ref": "#/definitions/safeRef"},
              "source_sha256": {"$ref": "#/definitions/hash"}
            }
          }
        },
        {
          "if": {"properties": {"usage_source": {"enum": ["none_required", "unavailable"]}}, "required": ["usage_source"]},
          "then": {
            "properties": {
              "input_tokens": {"type": "null"},
              "output_tokens": {"type": "null"},
              "cached_input_tokens": {"type": "null"},
              "reasoning_tokens": {"type": "null"},
              "total_tokens": {"type": "null"},
              "cost_minor_units": {"type": "null"},
              "currency": {"type": "null"},
              "source_ref": {"type": "null"},
              "source_sha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"cost_minor_units": {"type": "null"}}, "required": ["cost_minor_units"]},
          "then": {"properties": {"currency": {"type": "null"}}}
        },
        {
          "if": {"not": {"properties": {"cost_minor_units": {"type": "null"}}, "required": ["cost_minor_units"]}},
          "then": {"properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
        }
      ]
    }
  }
}
