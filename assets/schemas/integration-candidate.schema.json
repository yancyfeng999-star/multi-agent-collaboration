{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic integration candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "baseline_commit", "candidate_commit",
    "changed_paths", "verification", "risk_flags", "owner", "status",
    "dependencies", "logical_resources", "environment_resources", "workspace",
    "version_source", "migration_order", "release_lane", "quality_required", "quality_status"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "completed_at"],
        "properties": {
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["passed", "failed", "not_run"]},
          "completed_at": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "owner": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ready", "submitted", "integrated", "deferred", "blocked"]},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "logical_resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "environment_resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "workspace": {"type": "string", "minLength": 1},
    "version_source": {"type": ["string", "null"], "minLength": 1},
    "migration_order": {"type": "integer", "minimum": 0},
    "release_lane": {"type": "string", "minLength": 1},
    "quality_required": {"type": "boolean"},
    "quality_status": {"type": "string", "enum": ["not_required", "passed", "failed", "unknown"]}
  }
}
