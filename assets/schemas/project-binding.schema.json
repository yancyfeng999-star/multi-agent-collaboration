{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Governance Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storage_schema",
    "project_id",
    "project_name",
    "project_root",
    "project_key",
    "allowed_roots",
    "created_at"
  ],
  "properties": {
    "storage_schema": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "project_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "allowed_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "minLength": 1}
  }
}
